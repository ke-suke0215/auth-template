{
  "name": "auth-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint src worker scripts test vite.config.ts vitest.config.ts",
    "format": "biome format --write src worker scripts test vite.config.ts vitest.config.ts",
    "format:check": "biome format src worker scripts test vite.config.ts vitest.config.ts",
    "check": "biome ci src worker scripts test vite.config.ts vitest.config.ts",
    "audit": "npm audit --audit-level=high",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "auth:generate": "npx auth@1.6.26 generate --config scripts/better-auth.config.ts --output migrations/0001_better_auth.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply auth-template --local"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "hono": "^4.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@cloudflare/vite-plugin": "^1.7.0",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.20.0"
  }
}
